{
    "projectId": "69477c330029f16459cd",
    "projectName": "gridpunk-arcana",
    "hosting": [
        {
            "target": "web",
            "public": "dist",
            "ignore": [
                ".env",
                ".git",
                "node_modules",
                ".env.local",
                "src",
                "landing",
                "scripts"
            ],
            "commands": {
                "build": "npm run build"
            }
        }
    ],
    "functions": [
        {
            "$id": "gemini-proxy",
            "name": "gemini-proxy",
            "runtime": "node-20.0",
            "execute": [],
            "events": [],
            "schedule": "",
            "timeout": 15,
            "path": "functions/gemini-proxy",
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "ignore": [
                "node_modules",
                ".npm"
            ]
        },
        {
            "$id": "stripe-checkout",
            "name": "stripe-checkout",
            "runtime": "node-20.0",
            "execute": [],
            "events": [],
            "schedule": "",
            "timeout": 15,
            "path": "functions/stripe-checkout",
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "ignore": [
                "node_modules",
                ".npm"
            ]
        },
        {
            "$id": "stripe-webhook",
            "name": "stripe-webhook",
            "runtime": "node-20.0",
            "execute": [],
            "events": [],
            "schedule": "",
            "timeout": 15,
            "path": "functions/stripe-webhook",
            "entrypoint": "src/main.js",
            "commands": "npm install",
            "ignore": [
                "node_modules",
                ".npm"
            ]
        }
    ]
